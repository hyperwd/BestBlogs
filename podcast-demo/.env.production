# 生产环境配置文件
# 请根据实际情况修改以下配置

# 应用基础配置
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Dify API配置 (请替换为实际的API配置)
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=your-dify-api-key-here

# RSS配置
RSS_UPDATE_INTERVAL=30
CACHE_EXPIRY=10

# 安全配置 (可选)
# CORS_ORIGIN=https://your-domain.com
# API_SECRET_KEY=your-secret-key-here