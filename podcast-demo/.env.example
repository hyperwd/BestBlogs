# Dify API 配置 (多应用架构)
DIFY_API_URL=https://your-dify-instance.com/v1

# 音频转录应用
DIFY_TRANSCRIPTION_API_KEY=sk-transcription-app-api-key
DIFY_TRANSCRIPTION_WORKFLOW_ID=transcription-workflow

# 内容分析应用 (BestBlogs现有)
DIFY_ANALYSIS_API_KEY=sk-analysis-app-api-key
DIFY_ANALYSIS_WORKFLOW_ID=播客分析流程

# 文本翻译应用 (BestBlogs现有)
DIFY_TRANSLATION_API_KEY=sk-translation-app-api-key
DIFY_TRANSLATION_WORKFLOW_ID=播客分析结果翻译

# 应用配置
NEXT_PUBLIC_APP_NAME=智能播客电台演示平台
NEXT_PUBLIC_APP_VERSION=0.1.0

# 文件存储路径
AUDIO_STORAGE_PATH=./data/audio
TRANSCRIPT_STORAGE_PATH=./data/transcripts
NEWS_STORAGE_PATH=./data/news

# 数据库配置 (SQLite 用于演示)
DATABASE_URL=file:./data/podcast-demo.db

# RSS 刷新间隔（分钟）
RSS_REFRESH_INTERVAL=15

# 音频处理配置
MAX_AUDIO_SIZE_MB=100
SUPPORTED_AUDIO_FORMATS=mp3,wav,m4a,ogg

# 新闻推送配置
BREAKING_NEWS_THRESHOLD=8
PUSH_NOTIFICATION_ENABLED=true

# WebSocket 配置
WEBSOCKET_PORT=3001